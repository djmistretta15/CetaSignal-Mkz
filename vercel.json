{
  "version": 2,
  "name": "cetasignal",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://cetasignal-api.railway.app/api/$1" }
  ],
  "env": {
    "VITE_API_URL": "https://cetasignal-api.railway.app"
  }
}
